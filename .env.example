# ---------------------------------------------------------------- base de données
# Supabase auto-hébergé : toutes les tables de Master Break vivent dans le schéma `mb`.
# Session pooler (port 6543) ou connexion directe (5432) — les deux fonctionnent,
# le driver est configuré avec prepare:false.
DATABASE_URL="postgres://postgres:mot-de-passe@db.example.com:5432/postgres"
DATABASE_POOL=10

# Rôle de service Supabase, pour les tâches serveur qui contournent RLS (optionnel).
# SUPABASE_URL="https://supabase.example.com"
# SUPABASE_SERVICE_ROLE_KEY=""

# 1 = ne pas charger le jeu de démonstration au démarrage.
MB_SKIP_SEED=0

# --------------------------------------------------------------------- paiements
# PowerPay (Mobile Money Orange / MTN). Les webhooks sont branchés à l'étape 3.
# POWERPAY_BASE_URL="https://api.powerpay.cm"
# POWERPAY_MERCHANT_ID=""
# POWERPAY_API_KEY=""
# POWERPAY_WEBHOOK_SECRET=""
